; SmartMotion Motion: motion software for the SmartMotion simulator (replaces FlyPT Mover). Godot 4.6.
config_version=5

[application]
config/name="SmartMotion Motion"
config/description="Moves the SmartMotion simulator with SmartMotion Flight"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/icon.png"

[display]
window/size/viewport_width=1440
window/size/viewport_height=860
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[rendering]
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.007, 0.007, 0.18, 1)
