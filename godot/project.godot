; SmartMotion Flight (native). Godot 4.6, Forward+ renderer, OpenXR for Meta Quest via Link / Air Link.
config_version=5

[application]
config/name="SmartMotion Flight"
config/description="Flight game around Duxford for the SmartMotion simulator"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/icon.png"

[autoload]
Settings="*res://scripts/settings.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.007, 0.007, 0.18, 1)
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=2
textures/default_filters/anisotropic_filtering_level=4

[xr]

openxr/startup_alert=false
openxr/enabled=false
openxr/form_factor=0
openxr/view_configuration=1
openxr/reference_space=1
openxr/environment_blend_mode=0
shaders/enabled=true
; the headset gets the depth of each frame too, so Quest Link can fill in a late frame without the cockpit warping
openxr/submit_depth_buffer=true
